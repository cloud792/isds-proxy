# ─── OBBLIGATORIE ─────────────────────────────────────────────────
# Chiave API Anthropic (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Token admin per gestire codici e vedere statistiche
# Generalo con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=cambiami-con-un-token-lungo-e-casuale

# ─── OPZIONALI ────────────────────────────────────────────────────
# Porta del server (Railway la imposta automaticamente)
PORT=3000

# Origini consentite per CORS, separate da virgola
# Metti i domini da cui viene aperto iSDS_Completo.html (file:// e null per apertura locale)
# Lascia * per consentire tutto (sconsigliato in produzione)
ALLOWED_ORIGINS=*

# Modello Anthropic da usare (default: claude-sonnet-4-5)
ANTHROPIC_MODEL=claude-sonnet-4-5

# Max tokens per risposta (default: 6000)
MAX_TOKENS=6000

# Percorso cartella dati (default: ./data)
# Su Railway con volume montato metti es. /data
DATA_DIR=./data
